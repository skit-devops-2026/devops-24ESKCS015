{
  "title": "ReClaim - Server Overview",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests per Second",
      "type": "graph",
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m])) by (method, route)" }
      ]
    },
    {
      "id": 2,
      "title": "Requests by Status Code",
      "type": "graph",
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (status)" }
      ]
    },
    {
      "id": 3,
      "title": "Process CPU Seconds",
      "type": "graph",
      "targets": [
        { "expr": "rate(process_cpu_user_seconds_total[1m])" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}